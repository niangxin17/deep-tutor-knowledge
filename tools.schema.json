{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deep-tutor-knowledge tools",
  "description": "Frozen field names for Deep Tutor read-only knowledge MCP port (local whitelist files).",
  "tools": [
    {
      "name": "knowledge_list_sources",
      "description": "List allowlisted knowledge files under whitelist roots. Optional learner_id is accepted but ignored.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "learner_id": { "type": "string", "description": "Optional learner id (ignored)." }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["sources"],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "kind", "uri", "tags"],
              "properties": {
                "id": { "type": "string", "description": "e.g. methods/foo.md" },
                "title": { "type": "string" },
                "kind": { "type": "string", "enum": ["file", "note", "url"] },
                "uri": { "type": "string", "description": "file:// URI of the allowlisted file" },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    {
      "name": "knowledge_search",
      "description": "Search allowlisted file contents by substring over title+content. Returns hits with citations.",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "Search query (min trim length 2)." },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional filter to these source ids."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Max hits (default 5, max 20)."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["hits"],
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chunk_id", "source_id", "title", "snippet", "score", "citation"],
              "properties": {
                "chunk_id": { "type": "string" },
                "source_id": { "type": "string" },
                "title": { "type": "string" },
                "snippet": { "type": "string" },
                "score": { "type": "number" },
                "citation": {
                  "type": "object",
                  "required": ["source_id", "title", "locator"],
                  "properties": {
                    "source_id": { "type": "string" },
                    "title": { "type": "string" },
                    "locator": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "knowledge_get",
      "description": "Get file content by chunk_id (source_id#full) or source_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chunk_id": { "type": "string" },
          "source_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["chunk_id", "source_id", "title", "content", "citation"],
        "properties": {
          "chunk_id": { "type": "string" },
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "citation": {
            "type": "object",
            "required": ["source_id", "title", "locator"],
            "properties": {
              "source_id": { "type": "string" },
              "title": { "type": "string" },
              "locator": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "knowledge_domain_counts",
      "description": "Count allowlisted files per domain root for /studio cards. methods.extra.wikilinks counts [[wikilinks]]; concepts.extra.mentions counts concept-title occurrences across files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional domain ids (default: all whitelist roots)."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["counts"],
        "properties": {
          "counts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["domain", "items", "extra"],
              "properties": {
                "domain": { "type": "string" },
                "items": { "type": "integer" },
                "extra": {
                  "type": "object",
                  "properties": {
                    "wikilinks": { "type": "integer" },
                    "mentions": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "errors": [
    "NOT_IN_ALLOWLIST",
    "NOT_FOUND",
    "QUERY_TOO_SHORT",
    "FORBIDDEN_WRITE",
    "INVALID_ARGS"
  ]
}
